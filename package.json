{
  "name": "cs300-react-lab",
  "private": true,
  "version": "0.1.0",
  "description": "A client-side learning site for CS300 at NEIU: read, edit, run, and inspect code in the browser.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:content && vite",
    "build": "npm run build:content && vite build",
    "preview": "vite preview",
    "build:content": "node scripts/build-content.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "validate": "node scripts/validate-content.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test --pass-with-no-tests",
    "export:d2l": "node scripts/export-d2l.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "dependencies": {
    "es-module-lexer": "^3.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "sucrase": "^3.35.1",
    "vite": "^8.3.5"
  }
}
