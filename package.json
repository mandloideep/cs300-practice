{
  "name": "cs300-practice",
  "private": true,
  "version": "0.1.0",
  "description": "A client-side learning site for CS300 at NEIU: read, edit, run, and inspect code in the browser.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:content -- --all && vite",
    "build": "npm run build:content && vite build",
    "preview": "vite preview",
    "build:content": "node scripts/build-content.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "validate": "node scripts/validate-content.mjs --all",
    "new:topic": "node scripts/new-topic.mjs",
    "new:step": "node scripts/new-step.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern src scripts tests public/runtime/wrap",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:content -- --all && playwright test --pass-with-no-tests",
    "test:scripts": "node --test \"scripts/test/**/*.test.mjs\"",
    "export:d2l": "node scripts/export-d2l.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "upgrade:runtime": "node scripts/upgrade-runtime.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "es-module-lexer": "^3.0.4",
    "fflate": "^0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "sucrase": "^3.35.1",
    "vite": "^8.3.5"
  }
}
